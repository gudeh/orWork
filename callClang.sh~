#!/bin/bash

while IFS= read -r line; do
    # Extract the file path after the "modified:" keyword
    if [[ $line == modified:* ]]; then
        file_path=$(echo "$line" | awk '{print $NF}')
        # Apply clang-format to the file
        clang-format -i "$file_path"
    fi
done < "${1:-/dev/stdin}"
